# ---------------------------------------------------------------------------
# POS backend configuration. Copy this file to `.env` and adjust as needed.
# ---------------------------------------------------------------------------

# App
SECRET_KEY=change-me-to-a-random-secret-in-production
LITESTAR_DEBUG=true
LITESTAR_HOST=0.0.0.0
LITESTAR_PORT=8000
APP_URL=http://localhost:8000
LOG_LEVEL=20

# Database (PostgreSQL)
DATABASE_ECHO=false
DATABASE_ECHO_POOL=false
DATABASE_POOL_DISABLED=false
DATABASE_POOL_MAX_OVERFLOW=10
DATABASE_POOL_SIZE=5
DATABASE_POOL_TIMEOUT=30
DATABASE_USER=app
DATABASE_PASSWORD=app
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_DB=pos
DATABASE_URL=postgresql+psycopg://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_DB}

# Background worker (SAQ, uses Redis)
SAQ_REDIS_URL=redis://localhost:6379/0
SAQ_USE_SERVER_LIFESPAN=true
SAQ_WEB_ENABLED=true
SAQ_PROCESSES=1
SAQ_CONCURRENCY=10

# CORS - must list the exact origin(s) the Next.js frontend runs on.
# Wildcards ("*") are not allowed together with credentials/cookies.
ALLOWED_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Cookies: set to true once serving both apps over HTTPS in production.
COOKIE_SECURE=false

# Email (only used for password-reset / verification emails).
# "console" backend just prints emails to stdout - fine for local dev.
EMAIL_BACKEND=console
EMAIL_FROM_ADDRESS=noreply@localhost
EMAIL_FROM_NAME="POS"

# --- Optional integrations (leave blank to disable) ------------------------

# Google OAuth login
GOOGLE_OAUTH2_CLIENT_ID=
GOOGLE_OAUTH2_CLIENT_SECRET=

# GitHub OAuth login
GITHUB_OAUTH2_CLIENT_ID=
GITHUB_OAUTH2_CLIENT_SECRET=

# SMTP (production email). Only used when EMAIL_BACKEND=smtp.
# EMAIL_BACKEND=smtp
# EMAIL_SMTP_HOST=smtp.example.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASSWORD=
# EMAIL_USE_TLS=true

# Resend (production email). Only used when EMAIL_BACKEND=resend.
# EMAIL_BACKEND=resend
# RESEND_API_KEY=
